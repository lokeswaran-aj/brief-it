# Local development only. Match the credentials and host port in the root .env.
DATABASE_URL=postgresql://brief_it:brief_it_local@127.0.0.1:5432/brief_it

# Better Auth (generate a 32+ byte random secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth 2.0 Web Client (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
